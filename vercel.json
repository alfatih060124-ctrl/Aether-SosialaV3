{
  "version": 2,
  "builds": [
    { "src": "api/index.mjs", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.mjs" },
    { "src": "/aether-mark.svg", "dest": "/public/aether-mark.svg" },
    { "src": "/favicon.svg", "dest": "/public/favicon.svg" },
    { "src": "/og-aether.svg", "dest": "/public/og-aether.svg" },
    { "src": "/dashboard/?", "dest": "/public/dashboard.html" },
    { "src": "/onboarding/?", "dest": "/public/onboarding.html" },
    { "src": "/account/?", "dest": "/public/account.html" },
    { "src": "/marketplace/?", "dest": "/public/marketplace.html" },
    { "src": "/market/?", "dest": "/public/market.html" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ]
}
