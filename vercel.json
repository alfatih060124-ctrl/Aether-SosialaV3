{
  "version": 2,
  "builds": [
    { "src": "api/index.mjs", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.mjs" },
    { "src": "/dashboard/?", "dest": "/public/dashboard.html" },
    { "src": "/onboarding/?", "dest": "/public/onboarding.html" },
    { "src": "/account/?", "dest": "/public/account.html" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ]
}
