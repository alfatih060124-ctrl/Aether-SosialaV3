# Public API ingress. Read-only product data plus narrowly-scoped
# wallet authentication/account lanes are exposed here. Execution,
# simulation, billing, signal mutation, and Admin remain fenced inside PRIMARY_VM.
api.aether.boats {
  encode zstd gzip

  header {
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    Cache-Control "no-store"
    -Server
  }

  @public_read {
    method GET
    path /api/health /api/readiness /api/version /api/execution/status /api/signals/config /api/autotrade/status /api/trades /api/traders /api/traders/* /api/marketplace/fees /api/auth/session /api/account/wallet-portfolio /api/account/trader /api/account/copy-mandates
  }

  handle @public_read {
    reverse_proxy 127.0.0.1:8080
  }

  @wallet_auth_write {
    method POST
    path /api/auth/challenge /api/auth/verify /api/auth/logout /api/account/trader/challenge /api/account/trader/apply /api/account/copy-mandates
  }

  handle @wallet_auth_write {
    reverse_proxy 127.0.0.1:8080
  }

  @account_patch {
    method PATCH
    path /api/account/copy-mandates/*
  }

  handle @account_patch {
    reverse_proxy 127.0.0.1:8080
  }

  handle {
    respond "public API route not available" 404
  }
}

# Dedicated Admin control plane. It is intentionally NOT served by Vercel
# and is not reachable through api.aether.boats. Backend ADMIN_API_TOKEN
# authorization remains mandatory for every /api/admin/* request.
a.aether.boats {
  encode zstd gzip

  header {
    X-Content-Type-Options nosniff
    Referrer-Policy same-origin
    X-Frame-Options DENY
    Cache-Control "no-store"
    -Server
  }

  # The Admin UI reads these two already-public, read-only status/config endpoints
  # from the same origin. No mutation or Admin authorization is delegated here.
  @admin_support_read {
    method GET
    path /api/marketplace/fees /api/execution/status
  }
  handle @admin_support_read {
    reverse_proxy 127.0.0.1:8080
  }

  @admin_api path /api/admin /api/admin/*
  handle @admin_api {
    reverse_proxy 127.0.0.1:8080
  }

  @other_api path /api/*
  handle @other_api {
    respond "admin API route not available" 404
  }

  @admin_ui path / /admin /admin.html
  handle @admin_ui {
    root * /opt/aether-v3/web
    rewrite * /admin.html
    file_server
  }

  handle {
    respond "admin route not available" 404
  }
}
