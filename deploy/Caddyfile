# Public API ingress. Read-only product data plus narrowly-scoped
# wallet authentication/account lanes and SHADOW demo lanes are exposed here.
# LIVE execution, billing, Admin, signer material, and transaction submission remain fenced inside PRIMARY_VM.
api.aether.boats {
  encode zstd gzip

  header {
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    Cache-Control "no-store"
    -Server
  }

  @public_read {
    method GET
    path /api/health /api/readiness /api/version /api/execution/status /api/signals/config /api/autotrade/status /api/trades /api/traders /api/traders/* /api/marketplace/fees /api/auth/session /api/account/wallet-portfolio /api/account/trader /api/account/copy-mandates /api/account/copy-trades /api/account/positions /api/account/auto-strategy/demo
  }

  handle @public_read {
    reverse_proxy 127.0.0.1:8080
  }

  @wallet_auth_write {
    method POST
    path /api/auth/challenge /api/auth/verify /api/auth/logout /api/account/trader/challenge /api/account/trader/apply /api/account/copy-mandates /api/account/autotrade/evaluate /api/account/auto-strategy/simulate
  }

  handle @wallet_auth_write {
    reverse_proxy 127.0.0.1:8080
  }

  @account_patch {
    method PATCH
    path /api/account/copy-mandates/*
  }

  handle @account_patch {
    reverse_proxy 127.0.0.1:8080
  }

  @autotrade_demo_ui path /autotrade-demo /autotrade-demo.html
  handle @autotrade_demo_ui {
    root * /opt/aether-v3/public
    rewrite * /autotrade-demo.html
    file_server
  }

  handle {
    respond "public API route not available" 404
  }
}

# Dedicated Admin control plane. It is intentionally NOT served by Vercel
# and is not reachable through api.aether.boats. Backend ADMIN_API_TOKEN
# authorization remains mandatory for every /api/admin/* request.
a.aether.boats {
  encode zstd gzip

  header {
    X-Content-Type-Options nosniff
    Referrer-Policy same-origin
    X-Frame-Options DENY
    Cache-Control "no-store"
    -Server
  }

  # The Admin UI reads these two already-public, read-only status/config endpoints
  # from the same origin. No mutation or Admin authorization is delegated here.
  @admin_support_read {
    method GET
    path /api/marketplace/fees /api/execution/status
  }
  handle @admin_support_read {
    reverse_proxy 127.0.0.1:8080
  }

  @admin_api path /api/admin /api/admin/*
  handle @admin_api {
    reverse_proxy 127.0.0.1:8080
  }

  # PRIMARY_VM-only operator training surface. These are repository modules used
  # by the browser-side SHADOW training page. They do not expose credentials,
  # database state, signer material, transaction submission, or LIVE authority.
  handle /operator-modules/auto-trade-training.mjs {
    rewrite * /auto-trade-training.mjs
    root * /opt/aether-v3/services/api/src
    file_server
  }
  handle /operator-modules/signal-intelligence.mjs {
    rewrite * /signal-intelligence.mjs
    root * /opt/aether-v3/services/api/src
    file_server
  }
  handle /operator-modules/auto-trade-engine.mjs {
    rewrite * /auto-trade-engine.mjs
    root * /opt/aether-v3/services/api/src
    file_server
  }

  @operator_autotrade_ui path /operator-autotrade /operator-autotrade.html
  handle @operator_autotrade_ui {
    root * /opt/aether-v3/public
    rewrite * /operator-autotrade.html
    file_server
  }

  @other_api path /api/*
  handle @other_api {
    respond "admin API route not available" 404
  }

  @admin_ui path / /admin /admin.html
  handle @admin_ui {
    root * /opt/aether-v3/web
    rewrite * /admin.html
    file_server
  }

  handle {
    respond "admin route not available" 404
  }
}