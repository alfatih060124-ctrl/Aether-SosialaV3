# PRIMARY_VM environment template only.
# Render standby must not receive database or service/admin credentials.
NODE_ENV=production
PORT=8080
AETHER_DEPLOYMENT_ROLE=PRIMARY_VM
POSTGRES_PASSWORD=CHANGE_ME
API_TOKEN=CHANGE_ME
ADMIN_API_TOKEN=CHANGE_ME
AETHER_AUTH_DOMAIN=aether.boats

# Safety gates are intentionally fail-closed.
EXECUTION_MODE=SHADOW
LIVE_ENABLED=false
FIXTURE_GATE_PASSED=false
OPERATOR_APPROVED=false
MAX_EVENT_AGE_MS=30000
MIN_DECODER_CONFIDENCE=0.95
MAX_TRADER_DRAWDOWN_BPS=5000
MAX_SLIPPAGE_BPS=300

# Automatic trader evidence collection. Keep provider credentials only in runtime env;
# the API exposes only the non-secret endpoint label in provenance/audit output.
SOLANA_RPC_URL=
SOLANA_RPC_ENDPOINT_LABEL=primary-solana-rpc

# Member Auto Trade real-market SHADOW scheduler. Disabled by default.
# Admin may start/stop the in-process SHADOW worker from the dedicated control plane.
AUTOTRADE_SHADOW_SCHEDULER_ENABLED=false
AUTOTRADE_SHADOW_SCHEDULER_INTERVAL_MS=15000
AUTOTRADE_SHADOW_BATCH_LIMIT=20
AUTOTRADE_SHADOW_INITIAL_BALANCE_USDC=100
AUTOTRADE_PAPER_MIN_NET_EDGE_BPS=0.5
AUTOTRADE_PAPER_POSITION_SIZE_PCT=25
AUTOTRADE_PAPER_CANDIDATE_LIMIT=0
AUTOTRADE_PAPER_DEX_PAIR_ATTEMPTS=12
AETHER_HOTPATH_WORKERS=1
AETHER_FASTPATH_PAIR_LIMIT=2
AETHER_NATIVE_EXACT_PAIR_LIMIT=2
AETHER_NATIVE_DIRECT_PAIR_LIMIT=8
AETHER_NATIVE_RPC_CONCURRENCY=1
AETHER_NATIVE_WARM_CONCURRENCY=1
AETHER_JUPITER_INTER_QUOTE_DELAY_MS=80

# LIVE member funding preflight. Empty remains fail-closed.
# Configure the minimum SOL network-fee reserve in lamports before any LIVE authorization work.
LIVE_MIN_SOL_RESERVE_LAMPORTS=

# Reconciliation accounting. These values are NOT secrets.
# Supply canonical Solana quote mint addresses used by FIFO accounting. Empty is
# intentionally fail-closed: no reconciliation ledger row can be created until configured.
RECONCILIATION_QUOTE_MINTS=
# Explicit GeckoTerminal Solana pool used only for historical WSOL/USD 1-minute valuation
# at transaction time. The runtime verifies the returned pool contains canonical Wrapped SOL;
# it never guesses or dynamically selects a pool. Empty remains fail-closed.
RECONCILIATION_SOL_USD_POOL_ADDRESS=

# Aether Signal Intelligence — broad discovery, risk-sized execution.
# Liquidity/volume are sizing/observability signals; executable post-cost NET edge is authoritative.
SIGNAL_MIN_SCORE=82
SIGNAL_MIN_LIQUIDITY_USD=2000
SIGNAL_MIN_VOLUME_24H_USD=2000
SIGNAL_MAX_TOP10_HOLDER_PCT=100
SIGNAL_MAX_SPREAD_BPS=50
SIGNAL_MAX_PRICE_IMPACT_BPS=100
# PAPER opportunity gate: expected NET edge after executable swap effects and exact costs.
SIGNAL_MIN_EXPECTED_NET_EDGE_BPS=0.5
SIGNAL_MIN_TOKEN_AGE_HOURS=24
SIGNAL_MAX_DATA_AGE_MS=5000
SIGNAL_MIN_ROUTE_COUNT=2
SIGNAL_MIN_SOURCE_COUNT=2
SIGNAL_MAX_VOLATILITY_1H_BPS=1500
# Hot-path Jupiter fallback pacing. 80 ms plus single-worker/token pacing keeps
# direct two-leg quote evaluation inside the ≤300 ms scanner SLA while avoiding bursty 429s.
AETHER_JUPITER_INTER_QUOTE_DELAY_MS=80

# Auto Trade remains SHADOW/fail-closed until LIVE gates are explicitly implemented.
# During SHADOW evidence collection, daily trade-count and cooldown caps are bypassed so
# AETHER can build an unbiased transaction history. All signal/risk/slippage/exit guards remain active.
AUTOTRADE_SHADOW_UNLIMITED=true
AUTOTRADE_DEFAULT_MAX_TRADES_PER_DAY=6
AUTOTRADE_DEFAULT_COOLDOWN_SECONDS=1800
AUTOTRADE_DEFAULT_STOP_LOSS_BPS=500
AUTOTRADE_DEFAULT_TRAILING_STOP_BPS=350